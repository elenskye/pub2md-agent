# Select the active provider block below (deepseek / openai / openrouter).
# All providers are accessed through their OpenAI-compatible API.
LLM_PROVIDER=deepseek

DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_MODEL=
OPENAI_API_KEY=

OPENROUTER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Web search for terminology research. Without it, new terms fall back to
# an LLM guess tagged llm_fallback and flagged for review.
TAVILY_API_KEY=tvly-...

# Vision model (optional). Used for two things: formula → LaTeX
# transcription, and page layout (reading order + block roles, which fixes
# two-column interleaving). Any OpenAI-compatible vision model works —
# prefer an Instruct variant over a Thinking one. Unset ⇒ both features
# off: formulas stay [formula] placeholders and layout falls back to
# geometric column clustering.
VLM_MODEL=
VLM_API_KEY=
VLM_BASE_URL=
# Keep the VLM for formulas but force geometric layout parsing:
# VLM_LAYOUT=off

# Observability (optional): set these to stream full LangChain/LangGraph
# traces to LangSmith — no code changes needed, langchain reads the env.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=pub2md-agent

# --- Web app (webapp/) ---------------------------------------------------
# webapp/config/settings.py loads THIS file — there is no separate Django
# config and no .env inside webapp/.
# Production: set DEBUG false, a long random SECRET_KEY, and your domain.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DJANGO_ALLOWED_HOSTS=notes.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://notes.example.com
# Login wall. Default on. `off` drops it for a local single-user run and is
# refused whenever DJANGO_DEBUG=false, so a served instance always has one.
# PUB2MD_AUTH=off
# Account names for `manage.py rotate_accounts` (default guest1,guest2)
# PUB2MD_ACCOUNTS=guest1,guest2
# Guards (defaults shown)
# PUB2MD_MAX_UPLOAD_MB=100
# PUB2MD_MAX_PDF_PAGES=500
# PUB2MD_MONTHLY_BUDGET_USD=5.0
# PUB2MD_JOB_RETENTION_DAYS=7
# PUB2MD_JOB_STALE_MINUTES=45

# Optional cost/speed controls (defaults shown)
# MAX_TOKENS_PER_CALL=4096
# LLM_TEMPERATURE=0.3
# TRANSLATE_CONCURRENCY=4
# VLM_LAYOUT_CONCURRENCY=4
# Prices in USD per 1M tokens, only for the end-of-run cost estimate
# PRICE_INPUT_PER_M=0.27
# PRICE_OUTPUT_PER_M=1.10
